# Copy to .env and fill in real values. Never commit .env (only .env.example).

# --- ScyllaDB ---
# Comma-separated hosts; datacenter must match schemas.cql replication.
SCYLLA_HOSTS=127.0.0.1
SCYLLA_PORT=9042
SCYLLA_DATACENTER=datacenter1
# Main keyspace (tests use amigoact_test)
SCYLLA_KEYSPACE=amigoact

# --- Auth (AGENTS.md section 8: hybrid JWT access + opaque refresh) ---
# Secret for signing JWT access tokens (change in every environment)
JWT_SECRET=change-me-in-every-environment
# Access token lifetime in seconds (5-15 minutes per spec)
JWT_ACCESS_TTL_SECONDS=900
# Opaque refresh token lifetime in days (rotates on every use)
REFRESH_TOKEN_TTL_DAYS=14
# Verification / reset code lifetimes in minutes
VERIFICATION_CODE_TTL_MINUTES=15
RESET_CODE_TTL_MINUTES=15
# Rate limits: login attempts per window, refresh rotation per window,
# code attempts per window
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=60
REFRESH_MAX_ATTEMPTS=30
REFRESH_WINDOW_SECONDS=60
CODE_MAX_ATTEMPTS=5
CODE_WINDOW_SECONDS=300

# --- SMTP / verification mail ---
# Empty SMTP_HOST disables sending (use POST /auth/dev/challenge-code in dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
MAIL_FROM=no-reply@amigoact.local

# --- CORS / runtime ---
# Frontend origins allowed for CORS, comma-separated (no wildcard with cookies)
FRONTEND_URLS=http://localhost:5173
# Runtime environment: dev / test / prod
ENV=dev
# Comma-separated emails that always count as platform admins (bootstrap
# path; additional admins live in the platform_user_roles table)
PLATFORM_ADMIN_EMAILS=

# --- Media storage ---
# Local media storage root (org files live in <MEDIA_ROOT>/orgs/<org_id>/,
# gitignored). Swap to cloud later via MediaStore.
MEDIA_ROOT=./media
# Upload limits in megabytes
MEDIA_MAX_IMAGE_MB=10
MEDIA_MAX_VIDEO_MB=100

# --- Edge guard: second wall behind Cloudflare ---
# Master switch for the whole edge guard
GUARD_ENABLED=true
# Max in-flight HTTP requests; excess queues GUARD_QUEUE_MS then gets 503
GUARD_MAX_CONCURRENT=256
GUARD_QUEUE_MS=250
# Per-IP fixed-window limit (counter bucket 'edge:<ip>' in ScyllaDB)
GUARD_IP_MAX_HITS=300
GUARD_IP_WINDOW_SECONDS=60
# Early Content-Length rejection in megabytes (0 disables)
GUARD_MAX_BODY_MB=128
# Header carrying the real client IP behind a trusted edge proxy;
# only trustworthy when the origin is locked to that proxy. Empty = TCP peer
GUARD_CLIENT_IP_HEADER=cf-connecting-ip
# Extra comma-separated exempt paths beyond /health,/ready,/docs,/openapi.json
GUARD_EXEMPT_PATHS=

# --- WebSocket realtime (AGENTS.md section 16) ---
# One-time ticket TTL for POST /ws/tickets -> /ws?ticket= handshake
WS_TICKET_TTL_SECONDS=60
# Server heartbeat: ping.v1 interval and pong grace window
WS_HEARTBEAT_SECONDS=25
WS_PONG_TIMEOUT_SECONDS=10
# Frame cap and per-socket rate limits
WS_MAX_FRAME_BYTES=65536
WS_TICKET_PER_MIN=10
WS_FRAME_PER_SEC=20
