# Copy this file to .env and fill in DATABASE_URL and JWT_SECRET.
# The application reads these values only from .env. Never commit .env.
DATABASE_URL=

# Random secret of at least 32 characters that signs access tokens.
JWT_SECRET=

# Base64 of 32 random bytes that encrypt chat messages. Create one with: openssl rand -base64 32
# Losing this key makes the stored chat messages unreadable. Never change it on a database in use.
CHAT_ENCRYPTION_KEY=

# Optional. Address of the frontend, used to build links in account emails.
# FRONTEND_URL=

# Optional. Without SMTP_HOST, emails are written to the application log,
# including their links. Always set SMTP_HOST in production.
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# Optional. Folder where uploaded images are kept. Relative paths start from the working directory.
# MEDIA_DIR=media
