# Copy to .env and fill in real values. Never commit .env (only .env.example).
# ScyllaDB hosts, comma-separated
SCYLLA_HOSTS=127.0.0.1
# ScyllaDB CQL port
SCYLLA_PORT=9042
# ScyllaDB datacenter (must match schemas.cql replication)
SCYLLA_DATACENTER=datacenter1
# Main keyspace (tests use amigoact_test)
SCYLLA_KEYSPACE=amigoact
# Secret for signing JWT access tokens (change in every environment)
JWT_SECRET=change-me-in-every-environment
# Frontend origins allowed for CORS, comma-separated (no wildcard with cookies)
FRONTEND_URLS=http://localhost:5173
# Runtime environment: dev / test / prod
ENV=dev
